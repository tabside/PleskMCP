# Copy to .env (Portainer: paste as stack environment variables). Never commit real values.

# Public URL of the service as clients see it. A path prefix is allowed.
PUBLIC_BASE_URL=https://mcp.example.com/plesk
SERVICE_NAME=Plesk Files MCP
# Image tag to deploy (latest, a version like 0.2.12, or a commit sha)
PLESKMCP_TAG=latest

# Plesk XML API endpoint (port 8443, or 443 if Plesk is served there)
PLESK_URL=https://plesk.example.com:8443
PLESK_VERIFY_SSL=true

# SSH to the Plesk server as the unprivileged helper user created by server-setup/install.sh (worker service)
PLESK_SSH_HOST=plesk.example.com
PLESK_SSH_PORT=22
PLESK_SSH_USER=pleskmcp
# Path of the private key file on the Docker host, mounted as a secret (see docker-compose.yml)
PLESK_SSH_KEY_FILE=./pleskmcp_ssh_key
# Host key of the Plesk server: output of `ssh-keyscan -t ed25519 plesk.example.com`, type + base64 only
PLESK_SSH_HOST_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA...
# Alternative to PLESK_SSH_HOST_KEY: a mounted known_hosts file
# PLESK_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
# Parallel helper runs per worker container, worker containers, uvicorn processes per api container
SSH_MAX_CONCURRENCY=8
WORKER_REPLICAS=2
API_WORKERS=2

# Internal services (no published ports). Generate long random passwords, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb

# How the service re-checks that a customer still exists and is active (see README):
#   customer_key  per-customer Plesk secret key, created at login with the customer's credentials (default)
#   admin_key     administrator secret key, read-only use (PLESK_ADMIN_API_KEY)
#   login_only    no re-check after login (DNS and database tools unavailable)
ACCOUNT_CHECK_MODE=customer_key
# Fernet key for secret keys and stored database credentials. Generate with: pleskmcp generate-key
DATA_ENCRYPTION_KEY=
# customer_key mode: the IP Plesk sees the service connect from. Leave empty to let Plesk use the sender IP.
CUSTOMER_KEY_IP=
# Administrator secret key (read-only use). Required in admin_key mode; in customer_key mode optional, it lets
# the service resolve plan and add-on GUIDs to their names so ACCESS_PROFILES can be keyed by name.
# Create: plesk bin secret_key -c -ip-address <docker host ip> -description PleskMCP
PLESK_ADMIN_API_KEY=

# Access profiles: which subscriptions may connect and what they may do, keyed by the name (needs
# PLESK_ADMIN_API_KEY) or the GUID of the service plan or add-on plan. Subscriptions without a match are
# rejected. Several matches: the more generous value wins per field. Omitted fields use the defaults below.
#   scopes: files:read files:write dns:read dns:write db:read db:write db:admin
#   store_max_percent, store_max_bytes, backup_retention_days, trash_retention_days,
#   tool_calls_per_minute, tool_writes_per_minute, write_bytes_per_hour, max_databases_created
# Example: a cheap "AI Hosting" plan (files + DNS read only, small store) and the "KI-Zugang" add-on for
# existing customers (files, DNS read, database read and administration; db:write is prepared but not set).
ACCESS_PROFILES={"AI Hosting": {"scopes": ["files:read", "files:write", "dns:read"], "store_max_percent": 10, "store_max_bytes": 268435456, "backup_retention_days": 14, "trash_retention_days": 14, "tool_calls_per_minute": 60, "tool_writes_per_minute": 30, "write_bytes_per_hour": 104857600}, "KI-Zugang": {"scopes": ["files:read", "files:write", "dns:read", "db:read", "db:admin"], "max_databases_created": 3}}
# Alternative: a mounted JSON file
# ACCESS_PROFILES_FILE=/run/secrets/access_profiles.json
PLAN_CACHE_TTL=600

# Protected files (glob patterns relative to the document root): credentials are redacted on read, redacted
# values are never written back. Comma separated; leave empty for the default list.
# PROTECTED_FILES=wp-config.php,.env,.env.*,config/database.php,configuration.php,app/etc/env.php,*.pem,*.key,.htpasswd,.git/config
# Files the helper reads database credentials from, and result columns that are redacted in db_query
# DB_CONFIG_SOURCES=wp-config.php,.env,configuration.php,app/etc/env.php,config/database.php
# DB_REDACT_COLUMNS=user_pass,password,passwd,pass,api_key,apikey,secret,token,access_token,refresh_token,private_key,auth_key,salt
DB_MAX_ROWS=500
DB_MAX_AFFECTED_ROWS=1000
DB_QUERY_TIME_LIMIT=20
# db_create / db_drop through the Plesk XML API in the customer context. Switch on only after the
# verification described in README "Verifizierte Plesk-Fakten" succeeded on your installation.
DB_MANAGEMENT_ENABLED=false
MAX_DATABASES_CREATED=3

# Token lifetimes and the /account session (seconds)
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=2592000
ACCOUNT_SESSION_TTL=900

# Limits
READ_MAX_BYTES=2097152
WRITE_MAX_BYTES=5242880
LIST_MAX_ENTRIES=2000
LOG_MAX_LINES=500
LOG_MAX_SCAN_BYTES=209715200
BACKUP_MAX_FILE_BYTES=20971520
# Per-login tool limits (defaults when the profile does not set them)
TOOL_CALLS_PER_MINUTE=60
TOOL_WRITES_PER_MINUTE=30
WRITE_BYTES_PER_HOUR=209715200

# Jobs: the api waits TOOL_SYNC_WAIT seconds for a result, then returns a job_id (job_status)
TOOL_SYNC_WAIT=25
JOB_RESULT_TTL=3600
LOGIN_MAX_CONCURRENCY=2
HELPER_TIME_LIMIT=30
JOB_TIME_LIMIT=300

# Retention and quota (defaults when the profile does not set them)
TRASH_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=30
BACKUP_MIN_KEEP_DAYS=7
STORE_MAX_PERCENT=10
STORE_MAX_BYTES=1073741824
RETENTION_INTERVAL_HOURS=6
QUOTA_CACHE_TTL=600

# Login rate limits (failures per window). PLESK_FAIL_BUDGET is the global budget of failed Plesk logins
# from this service; it only counts IPs that are not already locked out. 0 disables it (recommended once
# the service IP is in Plesk's Fail2ban trusted list, see README).
LOGIN_FAIL_LIMIT_IP=10
LOGIN_FAIL_LIMIT_LOGIN=5
LOGIN_FAIL_WINDOW=900
PLESK_FAIL_BUDGET=4
PLESK_FAIL_BUDGET_WINDOW=600

# Reverse proxy address(es) whose X-Forwarded-For header is trusted
TRUSTED_PROXIES=127.0.0.1
# Prometheus endpoint <PUBLIC_BASE_URL>/metrics (no logins or paths in labels)
METRICS_ENABLED=true
# Logging: json (default) or text
LOG_FORMAT=json
LOG_LEVEL=INFO

# Docker host bind address and port of the api (behind the reverse proxy)
MCP_BIND_ADDR=127.0.0.1
MCP_HOST_PORT=8426

# ---------------------------------------------------------------------------------------------
# Self-signup "AI Hosting" (order form on the website, reBill/bexio invoice, activation after
# payment, suspension and deletion). Off by default; with SIGNUP_ENABLED=true every credential
# below is required (Netim only when new domains are orderable). See README "Self-Signup".
SIGNUP_ENABLED=false
# Website origins that may call the signup endpoints from the browser (CORS), comma separated
SIGNUP_ALLOWED_ORIGINS=https://www.example.com,https://example.com
# Version of the terms the customer accepts (stored with every order) and their URL
SIGNUP_TERMS_VERSION=2026-10
SIGNUP_TERMS_URL=https://www.example.com/agb/
# Confirmation page on the website (order id appended as ?order=); empty: built-in page
SIGNUP_SUCCESS_URL=https://www.example.com/ki-hosting/danke/
# Price list (hosting price, orderable TLDs); empty: the bundled pleskmcp/signup/data/domains.json
SIGNUP_PRICE_LIST_FILE=
SIGNUP_PLAN_NAME=AI Hosting
SIGNUP_HOSTING_PRICE=60.00
# Follow-up invoice this many months before the next period (reBill lead_months, 0-3)
SIGNUP_LEAD_MONTHS=1
# Form protection: minimum seconds between loading the form and submitting it; orders per IP per hour;
# orders per e-mail address per day
SIGNUP_MIN_FILL_SECONDS=5
SIGNUP_RATE_LIMIT_IP=5
SIGNUP_RATE_LIMIT_EMAIL=3
# Hours the e-mail confirmation link is valid; unconfirmed orders expire without any billing
SIGNUP_CONFIRM_TTL_HOURS=48
# Scheduler: payment poll of open orders, lifecycle check of active/suspended orders (seconds)
SIGNUP_PAYMENT_POLL_SECONDS=300
SIGNUP_LIFECYCLE_SECONDS=3600
# Days after the due date until suspension; days after suspension until deletion; domain renewal lead
SIGNUP_SUSPEND_AFTER_DAYS=10
SIGNUP_DELETE_AFTER_DAYS=60
SIGNUP_DOMAIN_RENEW_DAYS_BEFORE=30
# Before a subscription is deleted: plesk (default) runs `pleskbackup --domains-name` through the Plesk REST API
# (full backup into the server's backup repository, then deletion on the next run); manual waits for confirmation in
# the admin overview; none deletes directly. SIGNUP_BACKUP_TIMEOUT: seconds the backup may take.
SIGNUP_DELETE_BACKUP_MODE=plesk
SIGNUP_BACKUP_TIMEOUT=3600
# Admin overview <PUBLIC_BASE_URL>/signup/admin (HTTP Basic); empty: overview disabled
SIGNUP_ADMIN_USER=
SIGNUP_ADMIN_PASSWORD=
# reBill API (organization token, Settings -> API tokens). reBill carries the bexio connection: it matches or
# creates the bexio contact and refreshes invoice states (POST /subscriptions/{ref}/sync-payments); no bexio token here.
REBILL_API_URL=https://rebill.example.com/api/v1
REBILL_API_TOKEN=
# Netim reseller API; leave NETIM_LOGIN/NETIM_SECRET empty to disable ordering new domains
NETIM_API_URL=https://rest.netim.com/1.0
NETIM_LOGIN=
NETIM_SECRET=
# Netim contact ids for admin/tech/billing (isOwner=0) and the nameservers of new domains (2-5)
NETIM_CONTACT_ADMIN=
NETIM_CONTACT_TECH=
NETIM_CONTACT_BILLING=
NETIM_NAMESERVERS=ns1.example.net,ns2.example.net
# Plesk administrator secret key WITH write access for the signup (separate from PLESK_ADMIN_API_KEY); it is used
# for the XML API (customers, subscriptions, sessions) and as X-API-Key of the REST API (pleskbackup):
# plesk bin secret_key -c -ip-address <docker host ip> -description "PleskMCP signup"
PLESK_SIGNUP_API_KEY=
# IP address new subscriptions are created on (shared IP of the Plesk server)
PLESK_SIGNUP_IP=203.0.113.10
# Panel URL customers use (default: PLESK_URL); login link mode: session (one-time login via XML API
# create_session) or reset_page (link to the panel's "forgot password" page)
PLESK_PANEL_URL=https://plesk.example.com:8443
PLESK_LOGIN_LINK_MODE=session
# Zammad (token with ticket.agent rights for the group)
ZAMMAD_URL=https://support.example.com
ZAMMAD_TOKEN=
ZAMMAD_GROUP=Web TAB
# Welcome mail
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=Example Hosting <hosting@example.com>
MAIL_REPLY_TO=support@example.com
MAIL_BCC=
